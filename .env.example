# ham-tools environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.

# Your callsign
HAM_CALL=

# Path to TSV log file (default: ~/.ham_log.tsv)
HAM_LOG=

# TQSL station location name (for lotw_upload.sh)
HAM_LOC=

# Path to tqsl binary if not in PATH
TQSL_BIN=

# Your location (decimal degrees) — used by sat_passes.sh and weather.sh
HAM_LAT=
HAM_LON=

# City name passed to weather.sh from the launcher menu
HAM_WEATHER_LOC=

# n2yo.com API key (free registration at n2yo.com) — used by sat_passes.sh
N2YO_KEY=

# QRZ XML API credentials — used by qrz_lookup.sh
QRZ_USER=
QRZ_PASS=

# Output directory for CHIRP CSV files (used by /chirp-repeaters)
CHIRP_OUTPUT_DIR=/mnt/c/Projects/ham-tools/chirp-files
